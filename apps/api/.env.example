PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres 연결 문자열
# Supabase 대시보드 > Project Settings > Database > Connection string
#  - 서버(장기 실행): Session pooler (5432) 권장
#  - 마이그레이션: Direct connection 또는 Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL=true

# 앱인토스 파트너 API mTLS 인증서 (콘솔 > 개발 > mTLS 인증서에서 발급)
# 인증서·개인 키는 저장소 밖에 두고 절대 경로로 지정한다. 절대 커밋하지 말 것.
TOSS_MTLS_CERT_PATH=/absolute/path/to/<이름>_public.crt
TOSS_MTLS_KEY_PATH=/absolute/path/to/<이름>_private.key
