PORT=3000
NODE_ENV=development
# 쉼표로 여러 origin 지정. 앱인토스(SDK 3.1.0+)는 아래 두 origin, localhost 는 배포 전에 뺀다
#   https://headaltest.apps.tossmini.com (실서비스), https://headaltest.private-apps.tossmini.com (QR 테스트)
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres 연결 문자열
# Supabase 대시보드 > Project Settings > Database > Connection string
#  - 서버(장기 실행): Session pooler (5432) 권장
#  - 마이그레이션: Direct connection 또는 Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL=true

# 자체 access token(JWT) 서명 키. 32자 이상, 환경마다 다른 값을 쓴다
#   생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# 앱인토스 파트너 API 주소 (production 은 https://apps-in-toss-api.toss.im 만 허용)
# 로컬 개발은 가짜 파트너 API 를 띄우고 그 주소를 쓴다: pnpm --filter @haedalpoint/api dev:fake-partner
TOSS_PARTNER_API_BASE_URL=http://localhost:3100
# 가짜 파트너 API 가 돌려줄 익명키 (바꾸면 다른 테스트 사용자)
FAKE_ANON_KEY=local-dev-anon-key

# 앱인토스 파트너 API mTLS 인증서 (콘솔 > 개발 > mTLS 인증서에서 발급)
# 실제 파트너 API(https)를 부를 때만 필요하다. 아래 두 방식 중 한 쌍만 쓴다 (둘 다 있으면 base64 우선).
# 인증서·개인 키는 저장소에 절대 커밋하지 말 것.
#
# 1) 파일 경로 (로컬 개발): 저장소 밖에 두고 절대 경로로 지정
TOSS_MTLS_CERT_PATH=/absolute/path/to/<이름>_public.crt
TOSS_MTLS_KEY_PATH=/absolute/path/to/<이름>_private.key
#
# 2) base64 (Vercel 등 파일을 둘 수 없는 배포 환경): PEM 파일을 base64 한 줄로 만든 값
#   base64 -i <이름>_public.crt  | tr -d '\n' | pbcopy   → TOSS_MTLS_CERT_BASE64
#   base64 -i <이름>_private.key | tr -d '\n' | pbcopy   → TOSS_MTLS_KEY_BASE64 (Secret 으로 저장)
# TOSS_MTLS_CERT_BASE64=
# TOSS_MTLS_KEY_BASE64=
